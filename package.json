{
  "name": "@0xx0lostcause0xx0/polypack",
  "version": "1.1.0",
  "description": "Generic property graph engine with vector similarity search — extracted from scrollstr's PolyGraph",
  "keywords": [
    "graph",
    "property-graph",
    "vector-search",
    "similarity-search",
    "indexeddb",
    "rxjs"
  ],
  "homepage": "https://github.com/imattau/polypack#readme",
  "bugs": {
    "url": "https://github.com/imattau/polypack/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imattau/polypack.git"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./sync": {
      "types": "./dist/sync/index.d.ts",
      "import": "./dist/sync/index.js"
    }
  },
  "files": [
    "dist",
    "docs/API.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "tsc",
    "check": "npm test && npm run build && npm run check:exports",
    "check:exports": "node --input-type=module --eval \"const core = await import('./dist/index.js'); const sync = await import('./dist/sync/index.js'); const react = await import('./dist/react.js'); if (!core.PolyGraph || !sync.SyncClient || !react.useGraphQuery) process.exit(1)\"",
    "prepack": "npm run build",
    "prepublishOnly": "npm test && npm run build",
    "test": "vitest run",
    "test:gc": "NODE_OPTIONS=\"--expose-gc\" vitest run tests/cache-growth.test.ts",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "rxjs": "^7.8.2"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^26.1.0",
    "react": "^19.2.6",
    "tsx": "^4.23.1",
    "typescript": "~5.8.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  },
  "license": "MIT"
}
