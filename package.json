{
  "name": "@0xx0lostcause0xx0/polypack",
  "version": "3.1.0",
  "description": "Generic property graph engine with vector similarity search — extracted from scrollstr's PolyGraph",
  "keywords": [
    "graph",
    "property-graph",
    "vector-search",
    "similarity-search",
    "indexeddb",
    "rxjs"
  ],
  "homepage": "https://github.com/imattau/polypack#readme",
  "bugs": {
    "url": "https://github.com/imattau/polypack/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imattau/polypack.git"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./persistence": {
      "types": "./dist/persistence/index.d.ts",
      "import": "./dist/persistence/index.js"
    },
    "./persistence/node": {
      "types": "./dist/persistence/node.d.ts",
      "import": "./dist/persistence/node.js"
    },
    "./persistence/opfs": {
      "types": "./dist/persistence/opfs.d.ts",
      "import": "./dist/persistence/opfs.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./activation": {
      "types": "./dist/activation.d.ts",
      "import": "./dist/activation.js"
    },
    "./sync": {
      "types": "./dist/sync/index.d.ts",
      "import": "./dist/sync/index.js"
    }
  },
  "files": [
    "dist",
    "docs/API.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "tsc",
    "check": "npm test && npm run build && npm run check:exports && npm run check:browser && npm run check:build:browser",
    "check:exports": "node --input-type=module --eval \"const core = await import('./dist/index.js'); const persistence = await import('./dist/persistence/index.js'); const node = await import('./dist/persistence/node.js'); const opfs = await import('./dist/persistence/opfs.js'); const sync = await import('./dist/sync/index.js'); const react = await import('./dist/react.js'); const activation = await import('./dist/activation.js'); if (!core.PolyGraph || !core.PersistedGraphQuery || !core.FeatureHashEmbedding || !core.ActivationEngine || !core.mergeActivation || !activation.ActivationEngine || !activation.mergeActivation || !persistence.MemoryAdapter || !node.BinaryStoreAdapter || !node.NodeFileIO || !opfs.BinaryStoreAdapter || !opfs.OPFSFileIO || !sync.SyncClient || !sync.SyncServer || !react.useGraphQuery) process.exit(1)\"",
    "check:browser": "node scripts/check-browser-safe.mjs",
    "check:build:browser": "node scripts/browser-build-check.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm test && npm run build",
    "test": "vitest run --exclude 'tests/stress.test.ts'",
    "test:all": "vitest run",
    "test:gc": "NODE_OPTIONS=\"--expose-gc\" vitest run tests/cache-growth.test.ts",
    "test:conformance": "vitest run tests/conformance",
    "test:native": "vitest run tests/native",
    "test:stress": "NODE_OPTIONS=\"--expose-gc\" vitest run tests/stress.test.ts",
    "test:watch": "vitest",
    "bench:ts": "tsx benchmarks/run-ts.ts",
    "bench:rust": "cargo run --release -p polypack-core --bin compare -- --out benchmarks/results/rust-all.json",
    "bench:compare": "tsx benchmarks/compare.ts",
    "bench:query": "tsx benchmarks/query-gate.ts",
    "bench:database-core": "tsx benchmarks/database-core-ts.ts",
    "bench:database-core:extended": "tsx benchmarks/database-core-extended.ts",
    "bench:database-core:batches": "tsx benchmarks/database-core-batches.ts",
    "bench:database-core:batches:rust": "cargo run --release --manifest-path crates/Cargo.toml -p polypack-graph --example database_core_batches",
    "bench:database-core:batches:python": "PYTHONPATH=python python -m polypack.bench_batches",
    "bench:database-core:batches:compare": "tsx benchmarks/database-core-batches-compare.ts",
    "bench:database-core:queries": "tsx benchmarks/database-core-queries.ts",
    "bench:database-core:queries:rust": "cargo run --release --manifest-path crates/Cargo.toml -p polypack-graph --example database_core_queries",
    "bench:database-core:queries:python": "PYTHONPATH=python python -m polypack.bench_queries",
    "bench:database-core:queries:compare": "tsx benchmarks/database-core-queries-compare.ts",
    "bench:database-core:mixed": "tsx benchmarks/database-core-mixed.ts",
    "bench:database-core:mixed:rust": "cargo run --release --manifest-path crates/Cargo.toml -p polypack-graph --example database_core_mixed",
    "bench:database-core:mixed:python": "PYTHONPATH=python python -m polypack.bench_mixed",
    "bench:database-core:mixed:compare": "tsx benchmarks/database-core-mixed-compare.ts",
    "bench:scale": "tsx benchmarks/scale-characterization.ts",
    "bench:conformance": "npm run test:conformance"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "rxjs": "^7.8.2"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.8.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.28.1",
    "jsdom": "^26.1.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.7",
    "tsx": "^4.23.1",
    "typescript": "~5.8.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  },
  "license": "MIT"
}
