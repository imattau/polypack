{
  "name": "polypack",
  "version": "0.1.0",
  "description": "Generic property graph engine with vector similarity search — extracted from scrollstr's PolyGraph",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
"test:gc": "NODE_OPTIONS=\"--expose-gc\" vitest run tests/cache-growth.test.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "rxjs": "^7.8.2"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "react": "^19.2.6",
    "tsx": "^4.23.1",
    "typescript": "~5.8.0",
    "vitest": "^4.1.9"
  },
  "license": "MIT"
}
