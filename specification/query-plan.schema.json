{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://polypack.dev/schema/query-plan.schema.json",
  "title": "QueryPlan",
  "description": "Declarative query intermediate representation. Expresses the operations available on GraphQuery (in-memory) and PersistedGraphQuery (full store). Execution order: source selection -> attribute filters -> edge filters -> traversal -> order -> similarity -> offset/limit.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "nodeTypes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "attributes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "operator"],
        "properties": {
          "field": { "type": "string", "minLength": 1 },
          "operator": { "enum": ["eq", "range"] },
          "value": {},
          "above": { "type": "number" },
          "below": { "type": "number" }
        }
      }
    },
    "edgeFilter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 }
      }
    },
    "traversal": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["edgeType", "direction", "depth"],
        "properties": {
          "edgeType": { "type": "string", "minLength": 1 },
          "direction": { "enum": ["out", "in"] },
          "depth": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "joins": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["edgeType", "direction"],
        "properties": {
          "edgeType": { "type": "string", "minLength": 1 },
          "direction": { "enum": ["out", "in"] }
        }
      }
    },
    "similarity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vector", "threshold"],
      "properties": {
        "vector": { "type": "array", "items": { "type": "number" } },
        "threshold": { "type": "number" },
        "topK": { "type": "integer", "minimum": 0 },
        "engine": { "enum": ["exact", "hnsw"] }
      }
    },
    "order": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "direction"],
      "properties": {
        "field": { "type": "string", "minLength": 1 },
        "direction": { "enum": ["asc", "desc"] }
      }
    },
    "offset": { "type": "integer", "minimum": 0 },
    "limit": { "type": "integer", "minimum": 0 }
  }
}
