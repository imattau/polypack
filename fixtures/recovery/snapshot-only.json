        { "id": "s2", "type": "doc", "data": { "v": 2 }, "vector": null, "insertedAt": 2, "updatedAt": 2 }
      ],
      "edges": [
        { "id": "s1::REL::s2", "source": "s1", "type": "REL", "target": "s2", "data": null, "createdAt": 1 }
